# Copy to .env.local for local development (never commit real keys).
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site address (used for sitemap, canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (/admin). Server-only, never NEXT_PUBLIC. 12+ characters.
# Leave empty on your own computer to open the admin without a password (dev only).
# ADMIN_PASSWORD=
